# Turso. Si se dejan vacíos se usa solo el archivo local (modo desarrollo).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Archivo local (réplica embebida cuando hay TURSO_DATABASE_URL)
LOCAL_DB_PATH=flightsradar.db

DEFAULT_CURRENCY=COP
DEFAULT_LANGUAGE=es
DEFAULT_COUNTRY=CO

# Hubs usados para armar combinaciones de tiquetes separados
HUBS=BOG,PTY,MIA,FLL,MEX,LAX,SFO,JFK,MAD

# Radar: cada cuánto revisar las rutas vigiladas (minutos). 0 = desactivado
WATCH_INTERVAL_MINUTES=360

# Alertas por Telegram (opcional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

CORS_ORIGINS=http://localhost:3000
